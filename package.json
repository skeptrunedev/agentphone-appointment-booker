{
  "name": "agentphone-appointment-booker",
  "version": "0.2.0",
  "description": "Use AgentPhone to make constrained appointment-booking calls and save the results locally.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/cli/call.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/call.js",
    "call": "tsx src/cli/call.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
